---
import '@fontsource-variable/inter/opsz.css';
import '../styles/global.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-opsz-normal.woff2?url';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Container from '../components/Container.astro';
import { site } from '../site.config';

interface Props {
  /** Page title without the site name. Omit on the homepage. */
  title?: string;
  description?: string;
  /** Root-relative or absolute URL of a share image (1200x630 works best). */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  /** Keep this page out of search results (drafts, 404). */
  noindex?: boolean;
}

const { title, description = site.description, image, imageAlt, type = 'website', noindex = false } = Astro.props;

const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.profile.program}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;

// Default share image: 1200x630 card generated by scripts/make-social-card.py.
const shareImage = new URL(image ?? '/social-card.jpg', Astro.site ?? site.url).href;
const shareAlt = image ? imageAlt : `${site.name}, ${site.profile.program}, ${site.profile.school}`;

// While placeholders are showing, no page should be indexed by search engines.
const robots = noindex || site.placeholders ? 'noindex' : undefined;
---

<!doctype html>
<html lang="en" data-placeholders={site.placeholders ? 'on' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f7f5f0" />
    <meta name="author" content={site.name} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    {shareAlt && <meta property="og:image:alt" content={shareAlt} />}
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {
      site.placeholders && (
        <div class="preview-banner" role="note">
          <Container>
            <p>
              <strong>Site preview.</strong> Dashed boxes mark where content will go as projects and details are added.
            </p>
          </Container>
        </div>
      )
    }
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .preview-banner {
    padding-block: var(--space-2);
    background: var(--color-notice-bg);
    color: var(--color-notice-text);
    font-size: var(--text-xs);
    line-height: 1.5;
  }
</style>
