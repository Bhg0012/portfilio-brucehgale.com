---
/*
 * Homepage, ordered for a recruiter's first look and a hiring manager's
 * second: who Bruce is (hero), proof (selected work, what it demonstrates,
 * tools), background, then one clear next step (contact).
 *
 * Every section shows real content when it exists. In placeholder mode
 * (site.placeholders), dashed slots mark what is still to come.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Slot from '../components/Slot.astro';
import ContactBand from '../components/ContactBand.astro';
import ExperienceList from '../components/ExperienceList.astro';
import { getExperience } from '../lib/experience';
import { capabilityEvidence, getFeaturedProjects, getProjects, groupTools, shortTitle, toolsFrom } from '../lib/projects';
import { profilePhoto } from '../lib/profile';
import { site, hasContact } from '../site.config';

const P = site.placeholders;
const projects = await getProjects();
const featured = await getFeaturedProjects();
const selected = (featured.length > 0 ? featured : projects).slice(0, 3);
const fillerCount = P ? Math.max(0, 3 - selected.length) : 0;
const capabilities = capabilityEvidence(projects).filter((c) => P || c.projects.length > 0);
const tools = toolsFrom(projects);
const toolGroups = groupTools(tools);
const showWork = projects.length > 0 || P;
const showContactPage = hasContact || P;
const experience = await getExperience();
const current = experience.filter((e) => e.data.current);

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  affiliation: { '@type': 'CollegeOrUniversity', name: site.profile.school },
  sameAs: [site.contact.linkedin, site.contact.github].filter(Boolean),
};
---

<BaseLayout type="profile">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(personLd)} />

  <!-- Hero: who Bruce is, in one screen -->
  <section class="hero" aria-labelledby="hero-title">
    <Container class="hero__inner">
      <div class="hero__text">
        <p class="eyebrow">{site.profile.program} · {site.profile.school}</p>
        <h1 id="hero-title" class="hero__name">{site.name}</h1>
        <p class="hero__lede">
          {
            site.headline ?? (
              <>
                {site.profile.program} student {site.profile.honors ? `in the ${site.profile.school} ${site.profile.honors}` : `at ${site.profile.school}`}{' '}
                with a minor in {site.profile.minor}.
              </>
            )
          }
        </p>
        {
          current.length > 0 && (
            <ul class="now" aria-label="Currently">
              {current.map((e) => (
                <li class="now__item">
                  {e.data.logo && <Image src={e.data.logo} alt="" width={56} height={56} class="now__logo" />}
                  <span>
                    <span class="now__label">Currently</span> {e.data.role}, {e.data.organization}
                  </span>
                </li>
              ))}
            </ul>
          )
        }
        {
          P && !site.headline && (
            <Slot
              title="Positioning statement"
              text="One or two sentences on the business problems I help solve, written from my strongest projects once they are in."
              source="src/site.config.ts → headline"
            />
          )
        }
        <div class="hero__actions">
          {showWork && <Button href="/work/" arrow>View my work</Button>}
          {showContactPage && <Button href="/contact/" variant="secondary">Get in touch</Button>}
          {!showWork && !showContactPage && <Button href="/about/" arrow>About me</Button>}
          {
            site.resume && (
              <Button href={site.resume} variant="secondary">
                Resume (PDF)
              </Button>
            )
          }
        </div>
        {
          P && !site.resume && (
            <Slot
              variant="inline"
              title="Resume download button"
              text="Appears here and in the header once an approved PDF is added."
              source="public/downloads/ + resume in src/site.config.ts"
            />
          )
        }
      </div>
      <figure class="hero__photo">
        <Image
          src={profilePhoto.src}
          alt={profilePhoto.alt}
          widths={[360, 540, 720, 960]}
          sizes="(min-width: 80rem) 19rem, (min-width: 48rem) 24vw, 13rem"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </Container>
  </section>

  <!-- Key numbers, each linking to the work behind it -->
  {
    site.highlights && site.highlights.length > 0 && (
      <section class="highlights" aria-label="Highlights">
        <Container>
          <ul class="highlights__list" role="list">
            {site.highlights.map((h) => (
              <li class="highlight">
                <a href={h.href} class="highlight__link">
                  <span class="highlight__value">{h.value}</span>
                  <span class="highlight__label">{h.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </Container>
      </section>
    )
  }

  <!-- Proof: selected work -->
  {
    (selected.length > 0 || fillerCount > 0) && (
      <section class="block" aria-labelledby="selected-work">
        <Container>
          <SectionHeading
            id="selected-work"
            eyebrow="Selected work"
            title="Projects that show how I work"
            intro="Each case study covers the problem, my role, the approach, and the result."
            action={showWork ? { href: '/work/', label: 'All work' } : undefined}
          />
          <ProjectGrid projects={selected} placeholders={fillerCount} />
        </Container>
      </section>
    )
  }

  <!-- Proof: capabilities, each tied to the projects that demonstrate it -->
  {
    capabilities.length > 0 && (
      <section class="block" aria-labelledby="capabilities">
        <Container class="split">
          <div class="split__aside">
            <SectionHeading
              id="capabilities"
              eyebrow="What the work demonstrates"
              title="Skills, backed by projects"
              intro="Every skill listed here links to the work that shows it."
            />
          </div>
          <ol class="capabilities" role="list">
            {capabilities.map((c, i) => (
              <li class="capability">
                <span class="capability__num" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div>
                  <h3 class="capability__title">{c.label}</h3>
                  <p class="capability__text">{c.description}</p>
                  {c.projects.length > 0 ? (
                    <ul class="capability__evidence" aria-label="Shown in">
                      {c.projects.map((p) => (
                        <li>
                          <a href={`/work/${p.data.slug}/`}>{shortTitle(p)}</a>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="capability__pending">Supporting projects will be linked here.</p>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </Container>
      </section>
    )
  }

  <!-- Proof: tools, generated from project files -->
  {
    (tools.length > 0 || P) && (
      <section class="block" aria-labelledby="toolkit">
        <Container>
          <SectionHeading
            id="toolkit"
            eyebrow="Toolkit"
            title="Tools behind the work"
            intro="Every tool here was used in a project on this site. Each case study explains what I did with it."
          />
          {tools.length > 0 ? (
            <div class="toolgroups">
              {toolGroups.map((g) => (
                <section class="toolgroup">
                  <h3 class="toolgroup__title">{g.label}</h3>
                  <ul class="toolgroup__list" role="list">
                    {g.tools.map((tool) => (
                      <li>{tool.name}</li>
                    ))}
                  </ul>
                </section>
              ))}
            </div>
          ) : (
            <Slot
              title="Tools and technologies"
              text="Built automatically from the tools listed in each project, so every tool shown is backed by real work: analysis, visualization, databases, integrations, hosting, and AI."
              source="content/projects/*/index.md → tools"
            />
          )}
        </Container>
      </section>
    )
  }

  <!-- Background -->
  <section class="block" aria-labelledby="background">
    <Container>
      <SectionHeading id="background" eyebrow="Background" title="Education and experience" action={{ href: '/about/', label: 'More about me' }} />
      <div class="background">
        <article class="panel">
          <p class="panel__label">Education</p>
          <h3 class="panel__title">{site.profile.school}</h3>
          <p>{site.profile.degree ? `${site.profile.degree}, ${site.profile.program}` : site.profile.program}</p>
          <p class="panel__muted">Minor in {site.profile.minor}</p>
          {
            (site.profile.honors || site.profile.gpa) && (
              <p class="panel__muted">
                {[site.profile.honors, site.profile.gpa && `${site.profile.gpa} GPA`].filter(Boolean).join(' · ')}
              </p>
            )
          }
          {site.profile.graduation && <p class="panel__muted">Expected graduation: {site.profile.graduation}</p>}
          {
            P && !site.profile.graduation && (
              <Slot variant="inline" title="Expected graduation date" source="src/site.config.ts → profile.graduation" />
            )
          }
        </article>
        {
          experience.length > 0 ? (
            <article class="panel">
              <p class="panel__label">Experience</p>
              <ExperienceList items={experience} variant="compact" />
            </article>
          ) : (
            P && (
              <Slot
                title="Experience"
                text="Jobs, internships, and leadership roles: organization, role, dates, and what I was responsible for, linked to related projects."
                source="content/experience/"
              />
            )
          )
        }
      </div>
    </Container>
  </section>

  <ContactBand />
</BaseLayout>

<style>
  /* Hero */
  .hero {
    padding-block: clamp(3rem, 2rem + 4vw, 6rem) var(--space-7);
  }
  .hero :global(.hero__inner) {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }
  @media (min-width: 48rem) {
    .hero :global(.hero__inner) {
      grid-template-columns: minmax(0, 1fr) clamp(13rem, 24vw, 19rem);
      gap: clamp(var(--space-6), 4vw, var(--space-8));
    }
  }
  .hero__text {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
  }
  .hero__name {
    font-size: var(--text-display);
    line-height: 1;
  }
  .hero__lede {
    max-width: 36rem;
    color: var(--color-text-muted);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
  }
  .now {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .now__item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-weight: var(--weight-medium);
  }
  .hero :global(.now__logo) {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
  }
  .now__label {
    margin-right: var(--space-1);
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }
  .hero__photo {
    justify-self: center;
    width: min(100%, 19rem);
    order: -1;
  }
  @media (min-width: 48rem) {
    .hero__photo {
      order: 0;
      justify-self: end;
    }
  }
  .hero__photo :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 35%;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
  }
  @media (max-width: 47.99rem) {
    /* Small on phones so the name and summary stay in the first screen. */
    .hero :global(.hero__inner) {
      gap: var(--space-5);
    }
    .hero__photo {
      width: min(36%, 8.5rem);
      justify-self: start;
    }
    .hero__photo :global(img) {
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-md);
    }
  }

  /* Highlights: a quiet row of numbers between hairlines */
  .highlights__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  @media (min-width: 60rem) {
    .highlights__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .highlight {
    display: flex;
  }
  .highlight:nth-child(even) {
    border-left: 1px solid var(--color-border);
  }
  .highlight:nth-child(n + 3) {
    border-top: 1px solid var(--color-border);
  }
  @media (min-width: 60rem) {
    .highlight + .highlight {
      border-left: 1px solid var(--color-border);
    }
    .highlight:nth-child(n + 3) {
      border-top: 0;
    }
  }
  .highlight__link {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    width: 100%;
    padding: var(--space-5) var(--space-4);
    color: inherit;
    text-decoration: none;
  }
  @media (max-width: 59.99rem) {
    .highlight:nth-child(odd) .highlight__link {
      padding-left: 0;
    }
  }
  @media (min-width: 60rem) {
    .highlight__link {
      padding: var(--space-6) var(--space-5);
    }
    .highlight:first-child .highlight__link {
      padding-left: 0;
    }
  }
  .highlight__link:hover .highlight__label {
    color: var(--color-text);
  }
  .highlight__value {
    color: var(--color-accent);
    font-size: var(--text-2xl);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .highlight__label {
    max-width: 16rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    transition: color var(--duration-fast) var(--ease);
  }

  /* Sections */
  .block {
    padding-block: calc(var(--section-gap) / 2);
  }
  .block + .block {
    border-top: 1px solid var(--color-border);
  }

  /* Capabilities */
  .block :global(.split) {
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 60rem) {
    .block :global(.split) {
      grid-template-columns: 20rem minmax(0, 1fr);
      gap: var(--space-8);
    }
    .split__aside {
      position: sticky;
      top: calc(var(--header-height) + var(--space-6));
      align-self: start;
    }
  }
  .capabilities {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }
  .capability {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: var(--space-3);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }
  .capability__num {
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
    padding-top: 0.2rem;
  }
  .capability__title {
    font-size: var(--text-lg);
    letter-spacing: -0.01em;
  }
  .capability__text {
    margin-top: var(--space-1);
    color: var(--color-text-muted);
  }
  .capability__evidence {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }
  .capability__pending {
    display: inline-block;
    margin-top: var(--space-3);
    padding: var(--space-1) var(--space-3);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-pill);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  /* Tools: grouped columns of plain names */
  .toolgroups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: var(--space-6) var(--space-5);
  }
  .toolgroup {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-strong);
  }
  .toolgroup__title {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }
  .toolgroup__list {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-weight: var(--weight-medium);
  }

  /* Background */
  .background {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-5);
  }
  @media (min-width: 56rem) {
    .background {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
      align-items: start;
    }
  }
  .panel {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .panel__label {
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }
  .panel__title {
    font-size: var(--text-xl);
  }
  .panel__muted {
    color: var(--color-text-muted);
  }
  .panel :global(.slot) {
    margin-top: var(--space-3);
  }
</style>
