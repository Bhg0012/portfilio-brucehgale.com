---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { getProjects } from '../../lib/projects';
import { site } from '../../site.config';

const projects = await getProjects();
// In placeholder mode, show at least three cards so the layout can be judged.
const fillerCount = site.placeholders ? Math.max(0, 3 - projects.length) : 0;
---

<BaseLayout
  title="Work"
  description={`Case studies by ${site.name}: the problem, the role, the approach, and the result.`}
  noindex={projects.length === 0}
>
  <Container>
    <div class="header">
      <SectionHeading
        id="work-title"
        level="h1"
        eyebrow="Work"
        title="Case studies"
        intro="Projects from work, school, and my own initiatives. Each one covers the problem, my role, how I approached it, and what came of it."
      />
    </div>
    {
      projects.length > 0 || fillerCount > 0 ? (
        <ProjectGrid projects={projects} placeholders={fillerCount} headingLevel="h2" />
      ) : (
        <p class="empty">Case studies are being prepared and will appear here.</p>
      )
    }
  </Container>
</BaseLayout>

<style>
  .header {
    padding-top: clamp(3rem, 2rem + 4vw, 5.5rem);
  }
  .empty {
    padding: var(--space-6);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-lg);
    color: var(--color-text-muted);
  }
</style>
