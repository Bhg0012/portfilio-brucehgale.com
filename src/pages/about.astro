---
/*
 * About page: verified facts only. Story, experience, and interests are
 * added from approved material; until then placeholder mode marks the spots.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Slot from '../components/Slot.astro';
import ContactBand from '../components/ContactBand.astro';
import ExperienceList from '../components/ExperienceList.astro';
import { getExperience } from '../lib/experience';
import { getProjects, toolsFrom } from '../lib/projects';
import { profilePhoto } from '../lib/profile';
import { site } from '../site.config';

const P = site.placeholders;
const projects = await getProjects();
const tools = toolsFrom(projects);
const experience = await getExperience();
---

<BaseLayout title="About" description={`About ${site.name}, ${site.profile.program} student at ${site.profile.school}.`}>
  <section class="intro" aria-labelledby="about-title">
    <Container class="intro__inner">
      <div class="intro__text">
        <p class="eyebrow">About</p>
        <h1 id="about-title" class="intro__title">Hi, I'm {site.name.split(' ')[0]}.</h1>
        <p class="intro__lede">
          I'm a {site.profile.program} student {site.profile.honors ? `in the ${site.profile.school} ${site.profile.honors}` : `at ${site.profile.school}`}{' '}
          with a minor in {site.profile.minor}.
        </p>
        {
          P && (
            <Slot
              title="My story"
              text="A few short paragraphs: what drew me to analytics and marketing, the kind of problems I like working on, how I use AI in my work, and what I want to do next."
              source="src/pages/about.astro"
            />
          )
        }
      </div>
      <figure class="intro__photo">
        <Image
          src={profilePhoto.src}
          alt={profilePhoto.alt}
          widths={[320, 480, 640, 800]}
          sizes="(min-width: 80rem) 16rem, (min-width: 48rem) 20vw, 12rem"
          loading="eager"
        />
      </figure>
    </Container>
  </section>

  <section class="block" aria-labelledby="education">
    <Container>
      <SectionHeading
        id="education"
        eyebrow="Education"
        title={site.profile.school}
        intro={[site.profile.college, site.profile.degree].filter(Boolean).join(' · ') || undefined}
      />
      <div class="grid">
        {
          [
            { label: 'Major', value: site.profile.program },
            { label: 'Minor', value: site.profile.minor },
            site.profile.honors && { label: 'Honors', value: site.profile.honors },
            site.profile.gpa && { label: 'GPA', value: site.profile.gpa },
            site.profile.graduation && { label: 'Expected graduation', value: site.profile.graduation },
          ]
            .filter((i): i is { label: string; value: string } => Boolean(i))
            .map((i) => (
              <article class="panel">
                <p class="panel__label">{i.label}</p>
                <p class="panel__value">{i.value}</p>
              </article>
            ))
        }
        {P && !site.profile.graduation && <Slot title="Expected graduation" source="src/site.config.ts → profile.graduation" />}
      </div>
      <div class="grid grid--wide">
        {
          site.profile.activities && site.profile.activities.length > 0 ? (
            <article class="panel">
              <p class="panel__label">Organizations</p>
              {site.profile.activities.map((a) => (
                <p class="panel__value">
                  {a.name}
                  {a.detail && <span class="panel__detail">{a.detail}</span>}
                </p>
              ))}
            </article>
          ) : (
            P && (
              <Slot
                title="Honors, organizations, and activities"
                text="Confirmed items only, with roles and dates."
                source="src/site.config.ts → profile.activities"
              />
            )
          )
        }
        {
          P && (
            <Slot
              title="Relevant coursework"
              text="Courses that connect to the work on this site, linked to class projects where they exist."
              source="catalog/experience/ → approved details"
            />
          )
        }
      </div>
    </Container>
  </section>

  {
    (experience.length > 0 || P) && (
      <section class="block" aria-labelledby="experience">
        <Container>
          <SectionHeading
            id="experience"
            eyebrow="Experience"
            title="Where I've worked"
            intro="Jobs, internships, and the business I founded, most recent first."
          />
          {experience.length > 0 ? (
            <ExperienceList items={experience} projects={projects} />
          ) : (
            <Slot
              title="Roles: organization, title, and dates"
              text="What I was responsible for and what I accomplished, with links to related case studies."
              source="content/experience/"
            />
          )}
        </Container>
      </section>
    )
  }

  {
    (tools.length > 0 || P) && (
      <section class="block" aria-labelledby="skills">
        <Container>
          <SectionHeading id="skills" eyebrow="Skills" title="Tools I've used" />
          {tools.length > 0 ? (
            <ul class="tools" role="list">
              {tools.map((tool) => (
                <li>
                  <span class="tools__name">{tool.name}</span>
                  <span class="tools__where">
                    {tool.projects.map((p, i) => (
                      <>
                        {i > 0 && ', '}
                        <a href={`/work/${p.data.slug}/`}>{p.data.title}</a>
                      </>
                    ))}
                  </span>
                </li>
              ))}
            </ul>
          ) : (
            <Slot
              title="Skills and tools"
              text="Generated from project files: each tool listed with the case studies where I used it."
              source="content/projects/*/index.md → tools"
            />
          )}
        </Container>
      </section>
    )
  }

  {
    P && (
      <section class="block" aria-labelledby="beyond">
        <Container>
          <SectionHeading id="beyond" eyebrow="Outside of work" title="Beyond the resume" />
          <Slot
            title="Interests"
            text="A short, personal note: interests, activities, or what I do outside class and work."
            source="src/pages/about.astro"
          />
        </Container>
      </section>
    )
  }

  <ContactBand />
</BaseLayout>

<style>
  .intro {
    padding-block: clamp(3rem, 2rem + 4vw, 5.5rem) var(--space-6);
  }
  .intro :global(.intro__inner) {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }
  @media (min-width: 48rem) {
    .intro :global(.intro__inner) {
      grid-template-columns: minmax(0, 1fr) clamp(12rem, 20vw, 16rem);
      gap: var(--space-8);
    }
  }
  .intro__text {
    display: grid;
    gap: var(--space-5);
  }
  .intro__title {
    font-size: var(--text-3xl);
  }
  .intro__lede {
    max-width: var(--width-prose);
    color: var(--color-text-muted);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
  }
  .intro__photo {
    width: min(46%, 12rem);
    order: -1;
  }
  @media (min-width: 48rem) {
    .intro__photo {
      width: 100%;
      order: 0;
    }
  }
  .intro__photo :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 35%;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
  }
  .block {
    padding-block: calc(var(--section-gap) / 2);
    border-top: 1px solid var(--color-border);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: var(--space-4);
  }
  .grid--wide {
    align-items: start;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    margin-top: var(--space-4);
  }
  .panel {
    display: grid;
    align-content: start;
    gap: var(--space-1);
    padding: var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .panel__label {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }
  .panel__value {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
  }
  .panel__detail {
    display: block;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-normal);
  }
  .tools {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tools li {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }
  .tools__name {
    font-weight: var(--weight-semibold);
  }
  .tools__where {
    font-size: var(--text-sm);
  }
</style>
