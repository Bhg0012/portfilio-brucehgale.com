---
/*
 * Case-study layout preview, built only in placeholder mode.
 * Mirrors the section order of src/pages/work/[slug].astro with dashed
 * slots, so the structure can be reviewed before real projects exist.
 * Disappears automatically when site.placeholders is false.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Section from '../../components/Section.astro';
import Slot from '../../components/Slot.astro';
import { site } from '../../site.config';

export function getStaticPaths() {
  return site.placeholders ? [{ params: { page: 'case-study' } }] : [];
}

const SRC = 'content/projects/<slug>/index.md';
---

<BaseLayout title="Case study layout preview" description="Preview of the case study page layout." noindex>
  <article>
    <header class="hero">
      <Container>
        <p class="hero__back"><a href="/work/">← All work</a></p>
        <p class="eyebrow hero__eyebrow">Category · Category</p>
        <h1 class="hero__title">Case study layout preview</h1>
        <p class="hero__summary">
          This page shows where each part of a project write-up will appear. Every section is optional and only
          shows when the project has that information.
        </p>
        <div class="hero__meta">
          {
            ['Context', 'Role', 'Team', 'Timeframe', 'Status'].map((label) => (
              <div class="meta">
                <span class="meta__label">{label}</span>
                <span class="meta__value">from project file</span>
              </div>
            ))
          }
        </div>
      </Container>
    </header>

    <Container>
      <Slot
        variant="media"
        ratio="21 / 9"
        title="Cover image"
        text="The best single view of the finished work, with alt text."
        source="content/projects/<slug>/images/"
      />

      <div class="glance">
        <Slot title="The problem" text="The business question, who it mattered to, objectives, and constraints." source={`${SRC} → problem`} />
        <Slot title="What I did" text="Specific actions I personally took, separated from the team's work." source={`${SRC} → contributions`} />
        <Slot title="Results" text="Outcomes and deliverables. Any number cites the evidence behind it." source={`${SRC} → results`} />
      </div>

      <div class="narrative">
        <Slot
          title="The full story"
          text="The deeper explanation for hiring managers, under headings that fit the project: context, data or research, approach, key decisions, implementation, findings, and recommendations."
          source={`${SRC} → Markdown body`}
        />
      </div>

      <Section title="Visuals" id="visuals">
        <div class="visuals">
          <Slot variant="media" ratio="21 / 8" title="Screenshot or figure" text="With a caption explaining why it matters." source="content/projects/<slug>/images/" />
          <Slot variant="media" ratio="21 / 8" title="Screenshot or figure" text="Dashboards, campaign assets, interfaces, or diagrams." source="content/projects/<slug>/images/" />
        </div>
      </Section>

      <Section title="Tools and how I used them" id="tools" intro="Grouped by role, each with what I actually did with it.">
        <div class="three">
          <Slot variant="inline" title="Analysis and visualization" text="The analysis and reporting tools the project actually used." source={`${SRC} → tools`} />
          <Slot variant="inline" title="Source code, hosting, and data storage" text="Kept separate: where code lives, where the app runs, where data is stored." source={`${SRC} → tools`} />
          <Slot variant="inline" title="APIs, integrations, and automation" text="What connects to what, and why." source={`${SRC} → tools`} />
        </div>
      </Section>

      <Section title="How AI fits in" id="ai" intro="Two separate panels, so it is always clear which is which.">
        <div class="two">
          <Slot title="AI that helped me build it" text="How AI assisted planning, coding, analysis, or writing." source={`${SRC} → ai.assistance`} />
          <Slot
            title="AI inside the finished project"
            text="Models running in the project (local or hosted), techniques such as prompt design, retrieval, or structured outputs, and cost, privacy, and reliability tradeoffs."
            source={`${SRC} → ai.runtime`}
          />
        </div>
      </Section>

      <Section title="Reflection" id="reflection">
        <div class="three">
          <Slot variant="inline" title="What I learned" source={`${SRC} → reflection.lessons`} />
          <Slot variant="inline" title="Limitations" source={`${SRC} → reflection.limitations`} />
          <Slot variant="inline" title="What I would improve" source={`${SRC} → reflection.improvements`} />
        </div>
      </Section>

      <Section title="Resources" id="resources">
        <Slot variant="inline" title="Links" text="Repository, live demo, report, presentation, or dashboard, only when public and working." source={`${SRC} → links`} />
      </Section>
    </Container>
  </article>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-7) var(--space-6);
  }
  .hero__back {
    font-size: var(--text-sm);
  }
  .hero__back a {
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .hero__back a:hover {
    color: var(--color-accent);
  }
  .hero__eyebrow {
    margin-top: var(--space-6);
  }
  .hero__title {
    margin-top: var(--space-3);
    max-width: 22ch;
    font-size: var(--text-3xl);
  }
  .hero__summary {
    margin-block: var(--space-4) var(--space-6);
    max-width: var(--width-prose);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
  }
  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-6);
  }
  .meta {
    display: grid;
    gap: var(--space-1);
    font-size: var(--text-sm);
  }
  .meta__label {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }
  .meta__value {
    color: var(--color-text-muted);
    font-style: italic;
  }
  .glance,
  .three {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-5);
  }
  .glance {
    margin-top: var(--space-7);
  }
  .narrative {
    max-width: var(--width-prose);
    margin-top: var(--space-7);
  }
  .visuals {
    display: grid;
    gap: var(--space-5);
  }
  .two {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-5);
  }
</style>
