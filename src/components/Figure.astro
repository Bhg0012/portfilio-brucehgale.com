---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** Load immediately (use for the first image on a page). */
  priority?: boolean;
  sizes?: string;
}
const { src, alt, caption, priority = false, sizes = '(min-width: 72rem) 72rem, 100vw' } = Astro.props;
// Responsive sizes up to, never beyond, the original width.
const widths = [480, 800, 1200, 1600].filter((w) => w < src.width).concat(src.width);
---

<figure class="figure">
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    class="figure__image"
  />
  {caption && <figcaption class="figure__caption">{caption}</figcaption>}
</figure>

<style>
  .figure {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .figure__image {
    /* Natural size up to the column width; tall images are capped so they fit on screen. */
    width: auto;
    max-width: 100%;
    max-height: min(85vh, 56rem);
    margin-inline: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-muted);
  }
  .figure__caption {
    margin-top: var(--space-3);
    max-width: var(--width-prose);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-align: center;
  }
</style>
