---
import Container from './Container.astro';
import Icon from './Icon.astro';
import { site } from '../site.config';
import { getNavLinks } from '../lib/navigation';

const links = await getNavLinks();
const { email, linkedin, github } = site.contact;
interface ContactLink {
  href: string;
  label: string;
  rel?: string;
  icon?: 'mail' | 'linkedin';
}
const contactLinks: ContactLink[] = [];
if (email) contactLinks.push({ href: `mailto:${email}`, label: 'Email', icon: 'mail' });
if (linkedin) contactLinks.push({ href: linkedin, label: 'LinkedIn', rel: 'me', icon: 'linkedin' });
if (github) contactLinks.push({ href: github, label: 'GitHub', rel: 'me' });
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <Container>
    <div class="site-footer__top">
      <div class="site-footer__id">
        <p class="site-footer__name">{site.name}</p>
        <p class="site-footer__line">
          {site.profile.program} · {site.profile.school}
        </p>
      </div>
      <nav aria-label="Footer">
        <ul class="site-footer__links">
          <li><a href="/">Home</a></li>
          {
            links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
          {
            site.resume && (
              <li>
                <a href={site.resume}>Resume</a>
              </li>
            )
          }
          {
            contactLinks.map((link) => (
              <li>
                <a href={link.href} rel={link.rel} class="site-footer__contact">
                  {link.icon && <Icon name={link.icon} />}
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
    <p class="site-footer__copy">© {year} {site.name}</p>
  </Container>
</footer>

<style>
  .site-footer {
    margin-top: var(--section-gap);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
  .site-footer__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-5) var(--space-7);
    padding-top: var(--space-7);
  }
  .site-footer__name {
    color: var(--color-text);
    font-weight: var(--weight-semibold);
  }
  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer__links a {
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .site-footer__links a:hover {
    color: var(--color-accent);
  }
  .site-footer__contact {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }
  .site-footer__copy {
    padding-block: var(--space-6) var(--space-7);
  }
</style>
