---
import { Image } from 'astro:assets';
import {
  experienceTypeLabels,
  formatExperienceDates,
  initials,
  type Experience,
} from '../lib/experience';
import type { Project } from '../lib/projects';

interface Props {
  items: Experience[];
  /** "compact" for the homepage, "full" for the About page timeline. */
  variant?: 'compact' | 'full';
  /** Projects that may be linked (published in production). */
  projects?: Project[];
  headingLevel?: 'h3' | 'h4';
}
const { items, variant = 'full', projects = [], headingLevel: Heading = 'h3' } = Astro.props;
const projectBySlug = new Map(projects.map((p) => [p.data.slug, p]));
---

<ol class:list={['xp', `xp--${variant}`]} role="list">
  {
    items.map((item) => {
      const d = item.data;
      const dates = formatExperienceDates(item);
      const related = d.projects.map((slug) => projectBySlug.get(slug)).filter((p): p is Project => Boolean(p));
      return (
        <li class="xp__item">
          <div class="xp__logo">
            {d.logo ? (
              <Image src={d.logo} alt={`${d.organization} logo`} width={96} height={96} />
            ) : (
              <span class="xp__initials" aria-hidden="true">
                {initials(d.organization)}
              </span>
            )}
          </div>
          <div class="xp__body">
            <div class="xp__head">
              <Heading class="xp__role">{d.role}</Heading>
              {d.current && <span class="xp__now">Current</span>}
            </div>
            <p class="xp__org">
              {d.url ? <a href={d.url}>{d.organization}</a> : d.organization}
              {d.role !== experienceTypeLabels[d.type] && <span class="xp__type"> · {experienceTypeLabels[d.type]}</span>}
            </p>
            <p class="xp__meta">{[dates, d.location].filter(Boolean).join(' · ')}</p>
            {variant === 'full' && d.highlights.length > 0 && (
              <ul class="xp__highlights">
                {d.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            )}
            {variant === 'full' && d.skills.length > 0 && (
              <ul class="xp__skills" aria-label="Skills">
                {d.skills.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            )}
            {variant === 'full' && related.length > 0 && (
              <p class="xp__related">
                Case study:{' '}
                {related.map((p, i) => (
                  <>
                    {i > 0 && ', '}
                    <a href={`/work/${p.data.slug}/`}>{p.data.title}</a>
                  </>
                ))}
              </p>
            )}
          </div>
        </li>
      );
    })
  }
</ol>

<style>
  .xp {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .xp__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-4);
  }
  .xp__item + .xp__item {
    border-top: 1px solid var(--color-border);
  }
  .xp--full .xp__item {
    gap: var(--space-5);
    padding-block: var(--space-6);
  }
  .xp__logo :global(img),
  .xp__initials {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    object-fit: cover;
  }
  .xp--full .xp__logo :global(img),
  .xp--full .xp__initials {
    width: 3.5rem;
    height: 3.5rem;
  }
  .xp__initials {
    background: var(--color-surface-muted);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.02em;
  }
  .xp__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }
  .xp__role {
    font-size: var(--text-base);
    letter-spacing: -0.01em;
  }
  .xp--full .xp__role {
    font-size: var(--text-lg);
  }
  .xp__now {
    padding: 0.0625rem var(--space-2);
    border-radius: var(--radius-pill);
    background: var(--color-accent-soft);
    color: var(--color-accent-hover);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
  }
  .xp__org {
    font-weight: var(--weight-medium);
  }
  .xp__org a {
    color: var(--color-text);
    text-decoration-color: var(--color-border-strong);
  }
  .xp__org a:hover {
    color: var(--color-accent);
  }
  .xp__type,
  .xp__meta {
    color: var(--color-text-muted);
    font-weight: var(--weight-normal);
  }
  .xp__meta {
    font-size: var(--text-sm);
  }
  .xp__highlights {
    margin-top: var(--space-3);
    padding-left: 1.1rem;
    max-width: var(--width-prose);
  }
  .xp__highlights li + li {
    margin-top: var(--space-2);
  }
  .xp__skills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }
  .xp__skills li {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
  }
  .xp__related {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
  }
</style>
