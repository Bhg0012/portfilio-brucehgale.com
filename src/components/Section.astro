---
/** A titled case-study section. Render it only when it has content. */
interface Props {
  title: string;
  id?: string;
  /** Short line under the heading, e.g. to clarify scope. */
  intro?: string;
}
const { title, id, intro } = Astro.props;
const headingId = id ?? title.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<section class="section" aria-labelledby={headingId}>
  <h2 id={headingId} class="section__title">{title}</h2>
  {intro && <p class="section__intro">{intro}</p>}
  <div class="section__body"><slot /></div>
</section>

<style>
  .section {
    padding-top: var(--space-7);
  }
  .section__title {
    font-size: var(--text-xl);
  }
  .section__intro {
    margin-top: var(--space-2);
    max-width: var(--width-prose);
    color: var(--color-text-muted);
  }
  .section__body {
    margin-top: var(--space-5);
  }
</style>
