---
import Container from './Container.astro';
import { site } from '../site.config';
import { getNavLinks } from '../lib/navigation';

const links = await getNavLinks();
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <Container class="site-header__inner">
    <a href="/" class="brand" aria-current={path === '/' ? 'page' : undefined}>
      <span class="brand__mark" aria-hidden="true">BG</span>
      <span class="brand__name">{site.name}</span>
    </a>
    <nav aria-label="Main">
      <ul class="nav">
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
        {
          site.resume && (
            <li>
              <a href={site.resume} class="nav__resume">
                Resume
              </a>
            </li>
          )
        }
      </ul>
    </nav>
  </Container>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--color-border);
    background: rgb(247 245 240 / 0.86);
    backdrop-filter: saturate(160%) blur(12px);
    -webkit-backdrop-filter: saturate(160%) blur(12px);
  }
  .site-header :global(.site-header__inner) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--header-height);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text);
    text-decoration: none;
  }
  .brand:hover {
    color: var(--color-text);
  }
  .brand__mark {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-size: 0.75rem;
    font-weight: var(--weight-bold);
    letter-spacing: 0.02em;
  }
  .brand__name {
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
    white-space: nowrap;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 var(--space-3);
    border-radius: var(--radius-pill);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease),
      background-color var(--duration-fast) var(--ease);
  }
  .nav a:hover {
    color: var(--color-text);
    background: var(--color-surface-muted);
  }
  .nav a[aria-current='page'] {
    color: var(--color-text);
    background: var(--color-surface-muted);
  }
  .nav .nav__resume {
    margin-left: var(--space-2);
    border: 1px solid var(--color-border-strong);
    color: var(--color-text);
  }
  /* Small phones: drop the monogram so the name and all links fit on one line. */
  @media (max-width: 26rem) {
    .brand__mark {
      display: none;
    }
    .nav {
      gap: 0;
    }
    .nav a {
      padding: 0 var(--space-2);
    }
  }
</style>
