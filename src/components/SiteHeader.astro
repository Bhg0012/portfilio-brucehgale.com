---
import Container from './Container.astro';
import { site, hasContact } from '../site.config';
import { getProjects } from '../lib/projects';

const hasProjects = (await getProjects()).length > 0;

// Navigation lists only destinations that exist right now.
const links = [
  hasProjects && { href: '/work/', label: 'Work' },
  { href: '/about/', label: 'About' },
  hasContact && { href: '/about/#contact', label: 'Contact' },
  site.resume && { href: site.resume, label: 'Resume' },
].filter((l): l is { href: string; label: string } => Boolean(l));

const path = Astro.url.pathname;
const isCurrent = (href: string) => href !== '/' && !href.includes('#') && path.startsWith(href);
---

<header class="site-header">
  <Container class="site-header__inner">
    <a href="/" class="site-header__name" aria-current={path === '/' ? 'page' : undefined}>{site.name}</a>
    <nav aria-label="Main">
      <ul class="site-header__links">
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </Container>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }
  .site-header :global(.site-header__inner) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    min-height: 4rem;
    padding-block: var(--space-3);
  }
  .site-header__name {
    color: var(--color-text);
    font-weight: var(--weight-semibold);
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-tight);
    text-decoration: none;
  }
  .site-header__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-header__links a {
    display: inline-block;
    padding-block: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
  }
  .site-header__links a:hover,
  .site-header__links a[aria-current='page'] {
    color: var(--color-text);
  }
  .site-header__links a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.5em;
  }
</style>
